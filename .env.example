# Replace every placeholder with a unique random value before starting services.
# Use URL-safe random strings for the PostgreSQL role passwords.
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-unique-64-character-migrator-password
POSTGRES_APP_PASSWORD=replace-with-a-unique-64-character-application-password
DATABASE_URL=postgresql://trustvault_app:replace-with-a-unique-64-character-application-password@127.0.0.1:5432/trustvault
DB_MIGRATION_URL=postgresql://trustvault_migrator:replace-with-a-unique-64-character-migrator-password@127.0.0.1:5432/trustvault
MASTER_KEY=replace-with-a-unique-secret-of-at-least-32-bytes
AUDIT_HMAC_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
SESSION_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
# Optional locally (defaults to the public demo password); required for production seeding.
# Use a unique strong value and never reuse it outside demo accounts.
SEED_DEMO_PASSWORD=
# Optional: set to local-basic for demo-grade scanning; omit to reject uploads.
# Use ClamAV or another production antivirus provider for production deployments.
# MALWARE_SCANNER=local-basic
